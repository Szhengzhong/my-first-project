+static inline int minstrel_get_duration(int index, struct ssv_sta_rc_info *rc_sta)
+{
+    unsigned int group_id;
+    const struct mcs_group *group;
+    if(rc_sta->ht_rc_type == RC_TYPE_HT_LGI_20)
+        group_id = 0;
