+}
+static int ksmartlink_set_si_cmd(struct sk_buff *skb, struct genl_info *info)
+{
+    u32 si_cmd;
+    if (info == NULL)
+        return -EINVAL;
+    if (!info->attrs[KSMARTLINK_ATTR_SI_CMD])
+        return -EINVAL;
+    else {
