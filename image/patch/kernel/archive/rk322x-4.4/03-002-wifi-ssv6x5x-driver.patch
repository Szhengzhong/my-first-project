+    loop_times = simple_strtoul(argv[2], &endp, 10);
+    snprintf_res(cmd_data, "size & frames: %d & %d\n", size_per_frame, loop_times);
+    if (sc->ssv_txtput.txtput_tsk) {
+        snprintf_res(cmd_data, "txtput already in progress\n");
