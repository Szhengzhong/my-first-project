+        snprintf_res(cmd_data, "reg [r|w] [address] [value|word-count]\n\n");
+#ifdef SSV_SUPPORT_HAL
+        snprintf_res(cmd_data, "reg [br] [address] [word-count]\n\n");
+        snprintf_res(cmd_data, "reg [bw] [address] [value] [word-count]\n\n");
+#endif
+        return 0;
+    }
+    return -1;
+}
