+        dev_dbg(sc->dev, "Fail to read register");
+}
+EXPORT_SYMBOL(ssv6xxx_umac_reg_read);
+void ssv6xxx_umac_reg_write(char *driver_name, char *device_name, u32 addr, u32 value)
+{
+    int retval = 0;
