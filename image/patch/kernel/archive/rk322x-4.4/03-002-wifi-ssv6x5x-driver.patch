+#define SSV_HWIF_CAPABILITY_MASK 0x00000001
+#define SSV_HWIF_INTERFACE_MASK 0x00000002
+#define SSV_HWIF_CAPABILITY_SFT 0
+#define SSV_HWIF_INTERFACE_SFT 1
