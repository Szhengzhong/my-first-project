+u8 *inc_pn_key(void *priv)
+{
+    struct lib80211_wpi_data *data = priv;
+    int i;
+    data->pn_key[15] += 2;
+    if( data->pn_key[15] == 0x00 ) {
+        for(i = 14 ; i >= 0 ; i--) {
+            if( (data->pn_key[i] += 1) != 0x00 ) {
