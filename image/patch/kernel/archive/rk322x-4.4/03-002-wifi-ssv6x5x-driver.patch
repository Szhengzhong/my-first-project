+                    SET_RG_DPD_BB_SCALE_5100(regval);
+                    break;
+                case BAND_5500:
+                    SET_RG_DPD_BB_SCALE_5500(regval);
+                    break;
+                case BAND_5700:
+                    SET_RG_DPD_BB_SCALE_5700(regval);
+                    break;
+                case BAND_5900:
+                    SET_RG_DPD_BB_SCALE_5900(regval);
