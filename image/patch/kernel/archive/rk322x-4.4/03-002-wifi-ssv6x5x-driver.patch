+    static u64 ssv6200_get_systime_us(void) {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(2, 6, 39))
+        struct timespec ts;
+        get_monotonic_boottime(&ts);
+        return ((u64)ts.tv_sec * 1000000) + ts.tv_nsec / 1000;
+#else
+        struct timeval tv;
+        do_gettimeofday(&tv);
+        return ((u64)tv.tv_sec * 1000000) + tv.tv_usec;
+#endif
