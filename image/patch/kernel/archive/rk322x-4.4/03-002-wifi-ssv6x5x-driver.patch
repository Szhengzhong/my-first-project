+int ssv6006_get_pa_band(int ch)
+{
+    int pa_band = 0;
+    if (ch <=14) {
+        pa_band =0;
+    } else if (ch < 36) {
+        pa_band = 1;
+    } else if ((ch >= 36) && (ch < 100)) {
+        pa_band = 2;
+    } else if ((ch >= 100) && (ch < 140)) {
+        pa_band = 3;
+    } else if (ch >= 140) {
+        pa_band = 4;
+    }
+    return pa_band;
