+#endif
+#ifdef RATE_CONTROL_HT_STUPID_DEBUG
+    printk("HT sample result max_tp_rate[%d]max_tp_rate2[%d]max_prob_rate[%d]\n",mi->max_tp_rate,mi->max_tp_rate2,mi->max_prob_rate);
+#endif
+    mi->stats_update = jiffies;
