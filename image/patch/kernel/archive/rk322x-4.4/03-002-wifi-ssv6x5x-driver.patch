+    host_cmd->c_type = HOST_CMD;
+    host_cmd->h_cmd = (u8)SSV6XXX_HOST_CMD_SET_NOA;
+    host_cmd->len = skb->data_len;
+    memcpy(host_cmd->dat32, p2p_noa_param, sizeof(struct ssv6xxx_p2p_noa_param));
