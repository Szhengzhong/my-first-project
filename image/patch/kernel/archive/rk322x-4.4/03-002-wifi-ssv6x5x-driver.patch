+}
+void turismo_post_cal(SSV_HW *sh)
+{
+    SET_RG_MODE(MODE_STANDBY);
+    SET_RG_MODE_MANUAL(0);
+}
+void turismo_inter_cal(SSV_HW *sh)
+{
+    SET_RG_MODE(MODE_STANDBY);
+    UDELAY(100);
+    SET_RG_MODE(MODE_CALIBRATION);
+}
