+                }
+            } else {
+                ieee80211_wake_queues(sc->hw);
+            }
+        }
+#endif
+        if(sc->dbg_tx_frame) {
+            if(send_hci)
+                dev_dbg(sc->dev, "Tx frame send to HCI\n");
+            else
+                dev_dbg(sc->dev, "Tx frame queued\n");
+            dev_dbg(sc->dev, "================================================\n");
+        }
+    }
