+    address = sec_key_tbl + (vif_priv->vif_idx * sizeof(struct ssv6006_bss));
+    SMAC_REG_READ(sh, address, &temp);
+    temp = (temp & 0xffff00ff);
+    temp |= (cipher << 8);
+    SMAC_REG_WRITE(sh, address, temp);
+    dev_dbg(sh->sc->dev, "Set group key type %d\n", cipher);
+}
