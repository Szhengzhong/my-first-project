+static int _ssv_get_channel(unsigned int *pch)
+{
+    struct netlink_msg msg;
+    struct nlattr *na;
+    int mlength, retval;
+    struct sockaddr_nl nladdr;
+    int len;
+    msg.n.nlmsg_len = NLMSG_LENGTH(GENL_HDRLEN);
