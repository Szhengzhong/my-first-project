+    .name = "ssv_sdio_bridge",
+    .id_table = ssv_sdiobridge_devices,
+    .probe = ssv_sdiobridge_probe,
+    .remove = __devexit_p(ssv_sdiobridge_remove),
+#ifdef CONFIG_PM
+    .drv = {
+        .pm = &ssv_sdiobridge_pm_ops,
+    },
