+    if (len < 0)
+        return -1;
+    ptr = (void *)((size_t)skb_end_pointer(skb) - sizeof(prepare_mask));
+    memcpy(ptr, &prepare_mask, sizeof(prepare_mask));
+    return 0;
+}
