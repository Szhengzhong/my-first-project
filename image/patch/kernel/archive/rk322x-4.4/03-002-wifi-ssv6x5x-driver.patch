+    u32 count = 0;
+    if (argc == 2) {
+        __string2u32(argv[1], &count, 0);
+    } else if (argc == 1) {
+        count = 1;
+    } else {
+        snprintf_res(cmd_data, "\n ./cli tx_gen [n] \n");
+        return 0;
+    }
+    if (count != 0) {
+        int i;
+        for (i = 0; i < count; i++) {
+            HAL_CMD_TXGEN(sc->sh);
+            mdelay(1);
+        }
+    }
+    snprintf_res(cmd_data, "\n tx_gen %d times done \n", count);
+    return 0;
+}
