+                                  struct AMPDU_TID_st *ampdu_tid,
+                                  struct sk_buff_head *retry_queue,
+                                  u32 max_aggr_len)
+{
+    struct sk_buff *retry_mpdu;
+    struct sk_buff *new_ampdu_skb;
+    u32 num_retry_mpdu;
+    u32 temp_i;
