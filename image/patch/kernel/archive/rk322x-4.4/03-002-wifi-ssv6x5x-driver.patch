+#define SMAC_REG_WRITE(_s,_r,_v) \
+        ({ \
+            typeof(_s) __s = _s; \
+            if ( _s->sc->log_ctrl & LOG_REGW) \
+                printk("w a:0x%x d:0x%x\n", _r ,_v); \
