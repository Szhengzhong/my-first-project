+_osal_inline_ UINT16 osal_crc16(const UINT8 *buffer, const UINT32 length)
+{
+	UINT16 crc = 0;
+	UINT32 i = 0;
+
+	/* FIXME: Add STP checksum feature */
+	crc = 0;
+	for (i = 0; i < length; i++, buffer++)
+		crc = (crc >> 8) ^ crc16_table[(crc ^ (*buffer)) & 0xff];
+
+	return crc;
+}
