+*/
+/*----------------------------------------------------------------------------*/
+VOID cnmStaRecUninit(IN P_ADAPTER_T prAdapter)
+{
+	P_STA_RECORD_T prStaRec;
+	UINT_16 i;
+
+	for (i = 0; i < CFG_STA_REC_NUM; i++) {
+		prStaRec = &prAdapter->arStaRec[i];
+
