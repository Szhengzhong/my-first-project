+static int btif_dump_array(char *string, char *p_buf, int len)
+{
+	unsigned int idx = 0;
+	unsigned char str[30];
+	unsigned char *p_str;
+
+	pr_debug("========dump %s start <length:%d>========\n", string, len);
+	p_str = &str[0];
+	for (idx = 0; idx < len; idx++, p_buf++) {
+		sprintf(p_str, "%02x ", *p_buf);
+		p_str += 3;
+		if (7 == (idx % 8)) {
+			*p_str++ = '\n';
+			*p_str = '\0';
+			pr_debug("%s", str);
+			p_str = &str[0];
+		}
+	}
+	if (len % 8) {
+		*p_str++ = '\n';
+		*p_str = '\0';
+		pr_debug("%s", str);
+	}
+	pr_debug("========dump %s end========\n", string);
+	return 0;
+}
