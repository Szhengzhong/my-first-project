+		retval = len;
+		WMT_INFO_FUNC("wmt_dev:after read,wmt for aee buffer len(%d)\n", g_buf_len);
+	} else {
+		WMT_INFO_FUNC("wmt_dev: no data available for aee\n");
+		retval = 0;
+	}
+err_exit:
+	return retval;
