+		DBGLOG(REQ, ERROR, "request->n_ssids:%d\n", request->n_ssids);
+		return -EINVAL;
+	}
+
+	if (request->ie_len > 0) {
+		rScanRequest.u4IELength = request->ie_len;
+		rScanRequest.pucIE = (PUINT_8) (request->ie);
