+} NL80211_DRIVER_POORLINK_PARAMS, *P_NL80211_DRIVER_POORLINK_PARAMS;
+
+typedef enum _ENUM_TESTMODE_STA_STATISTICS_ATTR {
+	NL80211_TESTMODE_STA_STATISTICS_INVALID = 0,
