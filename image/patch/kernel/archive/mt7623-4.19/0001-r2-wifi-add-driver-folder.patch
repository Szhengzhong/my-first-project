+	NL80211_TESTMODE_STA_STATISTICS_AVG_PROCESS_TIME,
+	NL80211_TESTMODE_STA_STATISTICS_MAX_PROCESS_TIME,
+	NL80211_TESTMODE_STA_STATISTICS_AVG_HIF_PROCESS_TIME,
