+int mtk_cfg80211_set_power_mgmt(struct wiphy *wiphy, struct net_device *ndev, bool enabled, int timeout)
+{
+	P_GLUE_INFO_T prGlueInfo = NULL;
+	WLAN_STATUS rStatus;
+	UINT_32 u4BufLen;
+	PARAM_POWER_MODE ePowerMode;
+
+	prGlueInfo = (P_GLUE_INFO_T) wiphy_priv(wiphy);
