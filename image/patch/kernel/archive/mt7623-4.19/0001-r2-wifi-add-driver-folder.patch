+/*----------------------------------------------------------------------------*/
+VOID glResetHif(GLUE_INFO_T *GlueInfo)
+{
+	GL_HIF_INFO_T *HifInfo;
+
+	ASSERT(GlueInfo);
+	HifInfo = &GlueInfo->rHifInfo;
+	if (HifInfo->DmaOps)
+		HifInfo->DmaOps->DmaReset(HifInfo);
+}
