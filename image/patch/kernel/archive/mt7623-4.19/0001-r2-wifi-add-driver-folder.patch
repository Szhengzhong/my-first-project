+	       "kalCheckBowifVaild, arBowTable[ucBowTableIdx].fgIsValid, %x, %x.\n", ucBowTableIdx,
+		arBowTable[ucBowTableIdx].fgIsValid);
+#endif
+
+	return TRUE;
+
