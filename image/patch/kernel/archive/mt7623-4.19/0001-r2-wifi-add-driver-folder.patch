+#else
+INT32 mtk_wcn_consys_hw_bt_paldo_ctrl(UINT32 enable)
+{
+
+	if (enable) {
+		/*do BT PMIC on,depenency PMIC API ready */
+		/*switch BT PALDO control from SW mode to HW mode:0x416[5]-->0x1 */
+		if (reg_VCN33_BT) {
+			regulator_set_voltage(reg_VCN33_BT, 3300000, 3300000);
