+UINT_32 wlanCRC32(PUINT_8 buf, UINT_32 len)
+{
+	UINT_32 i, crc32 = 0xFFFFFFFF;
+
+	for (i = 0; i < len; i++)
+		crc32 = crc32_ccitt_table[(crc32 ^ buf[i]) & 0xff] ^ (crc32 >> 8);
+
+	return ~crc32;
+}
