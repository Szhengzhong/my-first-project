+			iRet = wmt_plat_sdio_ctrl(sdioSlotNum, FUNC_OFF);
+		} else {
+			WMT_WARN_FUNC("CTRL_SDIO_SLOT slotNum(%d) already OFF\n", sdioSlotNum);
