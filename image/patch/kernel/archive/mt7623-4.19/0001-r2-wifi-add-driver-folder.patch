+/*----------------------------------------------------------------------------*/
+WLAN_STATUS
+wlanoidQueryXmitMoreCollisions(IN P_ADAPTER_T prAdapter,
+			       IN PVOID pvQueryBuffer, IN UINT_32 u4QueryBufferLen, OUT PUINT_32 pu4QueryInfoLen)
+{
+	DEBUGFUNC("wlanoidQueryXmitMoreCollisions");
