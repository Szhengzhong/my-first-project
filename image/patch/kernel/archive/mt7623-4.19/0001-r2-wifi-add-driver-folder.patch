+/*----------------------------------------------------------------------------*/
+VOID rlmProcessAssocReq(P_ADAPTER_T prAdapter, P_SW_RFB_T prSwRfb, PUINT_8 pucIE, UINT_16 u2IELength)
+{
+	P_BSS_INFO_T prBssInfo;
