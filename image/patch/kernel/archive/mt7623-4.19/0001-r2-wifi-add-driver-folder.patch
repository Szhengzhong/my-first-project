+
+VOID HifRegDump(P_ADAPTER_T prAdapter)
+{
+	UINT_32 i;
+	UINT_32 RegVal = 0;
+
+	for (i = 0; i <= 0x58; i += 4) {
+		if ((i != MCR_WTDR0) && (i != MCR_WTDR1) && (i != MCR_WRDR0) &&
+			(i != MCR_WRDR1) && (i != MCR_WSDIOCSR) && (i != MCR_WRPLR)) {
+			HAL_MCR_RD(prAdapter, i, &RegVal);
+			DBGLOG(NIC, WARN, "HIF Reg 0x%x = 0x%x\n", i, RegVal);
+		}
+	}
+	DBGLOG(NIC, WARN, "\n\n");
+}
