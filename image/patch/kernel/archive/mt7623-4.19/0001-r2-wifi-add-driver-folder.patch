+	DEBUGFUNC("wlanoidSetP2pPowerSaveProfile");
+
+	ASSERT(prAdapter);
+	ASSERT(pu4SetInfoLen);
+
+	*pu4SetInfoLen = sizeof(PARAM_POWER_MODE);
