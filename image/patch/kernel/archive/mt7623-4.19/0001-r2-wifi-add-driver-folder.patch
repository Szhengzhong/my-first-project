+	kalMemCopy(prInvIndicate->group_bssid, prGlueInfo->prP2PInfo->rConnReqGroupAddr, MAC_ADDR_LEN);
+	prInvIndicate->name_len = prGlueInfo->prP2PInfo->u4ConnReqNameLength;
