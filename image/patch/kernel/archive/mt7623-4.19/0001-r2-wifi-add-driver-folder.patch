+
+	ASSERT(prAdapter);
+	ASSERT(prSwRfb);
+	ASSERT(pucIE);
+
+	prStaRec = cnmGetStaRecByIndex(prAdapter, prSwRfb->ucStaRecIdx);
+	ASSERT(prStaRec);
+	if (!prStaRec)
+		return;
+	ASSERT(prStaRec->ucNetTypeIndex < NETWORK_TYPE_INDEX_NUM);
