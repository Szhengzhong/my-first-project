+VOID wmt_core_dump_data(PUINT8 pData, PUINT8 pTitle, UINT32 len)
+{
+	PUINT8 ptr = pData;
+	INT32 k = 0;
+
+	WMT_INFO_FUNC("%s len=%d\n", pTitle, len);
+	for (k = 0; k < len; k++) {
+		if (k % 16 == 0)
+			WMT_INFO_FUNC("\n");
+		WMT_INFO_FUNC("0x%02x ", *ptr);
+		ptr++;
+	}
+	WMT_INFO_FUNC("--end\n");
+}
