+	for (u4QueArrayIdx = 0; u4QueArrayIdx < NUM_OF_PER_TYPE_TX_QUEUES; u4QueArrayIdx++)
+		QUEUE_INITIALIZE(&(prQM->arTxQueue[u4QueArrayIdx]));
