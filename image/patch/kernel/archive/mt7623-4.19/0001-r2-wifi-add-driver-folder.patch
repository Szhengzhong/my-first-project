+/*----------------------------------------------------------------------------*/
+static void wlanClearDevIdx(struct net_device *prDev)
+{
+	int i;
+
+	ASSERT(prDev);
+
+	for (i = 0; i < CFG_MAX_WLAN_DEVICES; i++) {
+		if (arWlanDevInfo[i].prDev == prDev) {
