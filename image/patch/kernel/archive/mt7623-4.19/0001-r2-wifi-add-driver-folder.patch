+	err = mtk_wcn_wmt_func_on(WMTDRV_TYPE_BT);
+	if (err != MTK_WCN_BOOL_TRUE) {
+		pr_err("%s func on failed with %d\n", __func__, err);
+		return -ENODEV;
+	}
+
+	set_bit(HCI_RUNNING, &hdev->flags);
+
+	mtk_wcn_stp_set_bluez(1);
