+* @return (none)
+*/
+/*----------------------------------------------------------------------------*/
+VOID TdlsexInit(ADAPTER_T *prAdapter)
+{
+	GLUE_INFO_T *prGlueInfo;
+
+	/* init */
+	prGlueInfo = (GLUE_INFO_T *) prAdapter->prGlueInfo;
