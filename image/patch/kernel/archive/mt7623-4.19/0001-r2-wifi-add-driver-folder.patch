+VOID rlmObssInit(P_ADAPTER_T prAdapter)
+{
+	P_BSS_INFO_T prBssInfo;
+	UINT_8 ucNetIdx;
+
+	RLM_NET_FOR_EACH(ucNetIdx) {
+		prBssInfo = &prAdapter->rWifiVar.arBssInfo[ucNetIdx];
+		ASSERT(prBssInfo);
