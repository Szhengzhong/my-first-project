+			break;
+		case 0x12:	/*NFC Beam + Indication */
+			DBGLOG(P2P, INFO, "NFC: Polling\n");
+			i4Status = mtk_cfg80211_testmode_get_scan_done(wiphy, data, len, prGlueInfo);
+			break;
+#endif
+#if CFG_AUTO_CHANNEL_SEL_SUPPORT
+		case 0x30:
