+INT32 wcn_core_dump_flush(INT32 rst, MTK_WCN_BOOL coredump_is_timeout)
+{
+	PUINT8 pbuf = NULL;
+	INT32 len = 0;
+
+	if (!g_core_dump) {
+		STP_DBG_ERR_FUNC("invalid pointer!\n");
+		return -1;
+	}
