+		if ((rRsnIe.u4AuthKeyMgtSuiteCount != 1) || (rRsnIe.au4AuthKeyMgtSuite[0] != RSN_AKM_SUITE_PSK)) {
+			*pu2StatusCode = STATUS_CODE_INVALID_AKMP;
+			return;
