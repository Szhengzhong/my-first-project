+/*----------------------------------------------------------------------------*/
+VOID nicPrintFirmwareAssertInfo(IN P_ADAPTER_T prAdapter)
+{
+	UINT_32 u4MailBox0, u4MailBox1;
+	UINT_32 line = 0;
+	UINT_8 aucAssertFile[7];
