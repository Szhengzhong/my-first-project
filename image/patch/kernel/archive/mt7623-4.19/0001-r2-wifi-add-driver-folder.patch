+		break;
+
+	case AUTH_MODE_SHARED:
+		DBGLOG(OID, INFO, "Current auth mode: Shared\n");
+		break;
+
+	case AUTH_MODE_AUTO_SWITCH:
+		DBGLOG(OID, INFO, "Current auth mode: Auto-switch\n");
+		break;
+
+	case AUTH_MODE_WPA:
+		DBGLOG(OID, INFO, "Current auth mode: WPA\n");
