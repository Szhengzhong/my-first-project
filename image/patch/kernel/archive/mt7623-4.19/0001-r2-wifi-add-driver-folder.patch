+/**********************************Hardware related defination**************************/
+#ifndef CONFIG_OF
+/*DMA channel's offset refer to AP_DMA's base address*/
+#define BTIF_TX_DMA_OFFSET 0x880
+#define BTIF_RX_DMA_OFFSET 0x900
