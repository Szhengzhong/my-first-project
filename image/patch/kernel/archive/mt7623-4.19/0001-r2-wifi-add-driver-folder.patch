+static void stp_dbg_dump_data(unsigned char *pBuf, char *title, int len)
+{
+	int k = 0;
+
+	pr_debug(" %s-len:%d\n", title, len);
+
+	for (k = 0; k < len; k++) {
+		if (k % 16 == 0 && k != 0)
+			pr_cont("\n    ");
+		pr_cont("0x%02x ", pBuf[k]);
+	}
+	pr_debug("--end\n");
+}
