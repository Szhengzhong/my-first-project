+VOID nicTxLifetimeRecordEn(IN P_ADAPTER_T prAdapter, IN P_MSDU_INFO_T prMsduInfo, IN P_NATIVE_PACKET prPacket)
+{
+	P_PKT_PROFILE_T prPktProfile = &prMsduInfo->rPktProfile;
