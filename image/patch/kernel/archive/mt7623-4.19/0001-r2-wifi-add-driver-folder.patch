+INT32 osal_wake_lock_init(P_OSAL_WAKE_LOCK pLock)
+{
+	if (!pLock)
+		return -1;
+
+	#ifdef CONFIG_PM_WAKELOCKS
+	wakeup_source_init(&pLock->wake_lock, pLock->name);
