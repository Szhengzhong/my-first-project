+
+		*f_pos += count;
+		g_buf_len -= count;
+		pBuf += count;
+		WMT_INFO_FUNC("wmt_dev:after read,wmt for aee buffer len(%d)\n", g_buf_len);
+
+		retval = count;
+	} else if (0 != g_buf_len) {
+
+		retval = copy_to_user(buf, pBuf, g_buf_len);
