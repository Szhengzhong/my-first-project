+	if (strncmp(prDev->name, "p2p", 3) == 0) {
+		/* because we store the address of prGlueInfo in p2p's private date of net device */
+		/* *((P_GLUE_INFO_T *) netdev_priv(prGlueInfo->prP2PInfo->prDevHandler)) = prGlueInfo; */
