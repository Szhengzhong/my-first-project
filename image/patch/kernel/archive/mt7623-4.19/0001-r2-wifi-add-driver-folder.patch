+	(PUINT_8) DISP_STRING("P2P_STATE_GC_JOIN")
+};
+
+/*lint -restore */
+#else
+static UINT_8 apucDebugP2pState[P2P_STATE_NUM] = {
+	P2P_STATE_IDLE,
+	P2P_STATE_SCAN,
+	P2P_STATE_AP_CHANNEL_DETECT,
+	P2P_STATE_REQING_CHANNEL,
+	P2P_STATE_CHNL_ON_HAND,
+	P2P_STATE_GC_JOIN
+};
+
+#endif /* DBG */
