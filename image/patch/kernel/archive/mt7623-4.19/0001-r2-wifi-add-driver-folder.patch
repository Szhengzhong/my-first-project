+		if (ret || (u4_result != sizeof(WMT_HOST_AWAKE_CMD))) {
+			WMT_ERR_FUNC("wmt_core: HOST_AWAKE_CMD ret(%d) cmd len err(%d, %d) ", ret, u4_result,
+				     sizeof(WMT_HOST_AWAKE_CMD));
+			goto pwr_sv_done;
+		}
+
+		evt_len = sizeof(WMT_HOST_AWAKE_EVT);
