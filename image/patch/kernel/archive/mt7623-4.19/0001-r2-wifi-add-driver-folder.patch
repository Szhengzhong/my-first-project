+INT32 wmt_dev_patch_put(osal_firmware **ppPatch)
+{
+	if (NULL != *ppPatch) {
+		if ((*ppPatch)->data)
+			vfree((*ppPatch)->data);
+
+		kfree(*ppPatch);
+		*ppPatch = NULL;
+	}
+	return 0;
+}
