+	P_EVENT_STA_STATISTICS_T prEvent;
+	P_GLUE_INFO_T prGlueInfo;
+	P_PARAM_GET_STA_STATISTICS prStaStatistics;
+
+	if ((prAdapter == NULL)
+		|| (prCmdInfo == NULL)
+		|| (pucEventBuf == NULL)
+		|| (prCmdInfo->pvInformationBuffer == NULL)) {
+		ASSERT(FALSE);
+		return;
