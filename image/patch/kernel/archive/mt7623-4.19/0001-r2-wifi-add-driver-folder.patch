+* DESCRIPTION
+*  BTIF module init, after this step, BTIF should enable to do tx/rx with PIO
+*  mode
+* PARAMETERS
+* p_base   [IN]        BTIF module's base address
+* RETURNS
+*  0 means success, negative means fail
+*****************************************************************************/
+int hal_btif_hw_init(P_MTK_BTIF_INFO_STR p_btif);
+
+/*****************************************************************************
+* FUNCTION
+*  hal_btif_rx_cb_reg
+* DESCRIPTION
