+#undef DFT_TAG
+#endif
+#define DFT_TAG "[WMT-CONSYS-HW]"
+
+/*******************************************************************************
+*                    E X T E R N A L   R E F E R E N C E S
+********************************************************************************
+*/
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/memblock.h>
+#include "osal_typedef.h"
+#include "mtk_wcn_consys_hw.h"
