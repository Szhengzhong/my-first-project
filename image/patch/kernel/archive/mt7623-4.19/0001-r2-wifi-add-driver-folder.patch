+int btif_dump_data(char *p_buf, int len)
+{
+	unsigned int idx = 0;
+	unsigned char str[30];
+	unsigned char *p_str;
+
+	p_str = &str[0];
+	for (idx = 0; idx < len; idx++, p_buf++) {
+		sprintf(p_str, "%02x ", *p_buf);
