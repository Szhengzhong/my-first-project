+#if CFG_ENABLE_BT_OVER_WIFI
+		else if (NETWORK_TYPE_BOW_INDEX == eNetTypeIndex) {
+
+			if (prBssInfo->eCurrentOPMode == OP_MODE_ACCESS_POINT) {
+				/* Do nothing */
+				/* TODO(Kevin): TBD */
+			}
+		}
