+/*----------------------------------------------------------------------------*/
+WLAN_STATUS bssProcessProbeRequest(IN P_ADAPTER_T prAdapter, IN P_SW_RFB_T prSwRfb)
+{
+	P_WLAN_MAC_MGMT_HEADER_T prMgtHdr;
+	P_BSS_INFO_T prBssInfo;
+	P_IE_SSID_T prIeSsid = (P_IE_SSID_T) NULL;
