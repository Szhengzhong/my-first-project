+	}
+
+	return wlanSendSetQueryCmd(prAdapter,
+				   CMD_ID_INDICATE_PM_BSS_CONNECTED,
+				   TRUE,
+				   FALSE,
+				   FALSE,
+				   NULL,
+				   NULL,
+				   sizeof(CMD_INDICATE_PM_BSS_CONNECTED),
+				   (PUINT_8)&rCmdIndicatePmBssConnected, NULL, 0);
