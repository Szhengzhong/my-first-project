+
+	if ((osal_strlen(pos) > 2) && ((*pos) == '0') && (*(pos + 1) == 'x')) {
+		ret = osal_strtol(pos + 2, 16, &res);
+		if (ret)
+			WMT_ERR_FUNC("fail(%d)\n", ret);
+		*dst = res;
+		WMT_DBG_FUNC("wmtcfg==> %s=0x%x\n", data->name, *dst);
+	} else {
