+	MTK_WCN_BOOL bRet = (0 == g_es_lr_flag_for_quick_sleep) ? MTK_WCN_BOOL_FALSE : MTK_WCN_BOOL_TRUE;
+	/* WMT_INFO_FUNC("bRet:%d\n", bRet); */
