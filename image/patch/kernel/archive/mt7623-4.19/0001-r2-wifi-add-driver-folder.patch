+
+/* struct timeval tv; */
+
+/* do_gettimeofday(&tv); */
+/* return tv.tv_usec + tv.tv_sec * (UINT_64)1000000; */
+
+	UINT_64 u8Clk;
+/* UINT32 *pClk = &u8Clk; */
+
+	u8Clk = sched_clock();	/* unit: naro seconds */
+/* printk("<stats> sched_clock() = %x %x %u\n", pClk[0], pClk[1], sizeof(jiffies)); */
+
+	return (UINT_64) u8Clk;	/* sched_clock *//* jiffies size = 4B */
+}
