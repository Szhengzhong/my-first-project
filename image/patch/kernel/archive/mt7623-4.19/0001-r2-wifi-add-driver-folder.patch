+* RETURNS
+*  0 means success; negative means fail; positive means rx data length
+*****************************************************************************/
+int hal_btif_irq_handler(P_MTK_BTIF_INFO_STR p_btif,
+			 unsigned char *p_buf, const unsigned int max_len);
+
+/*****************************************************************************
