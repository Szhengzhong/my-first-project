+#define CONSYS_ROM_RAM_DELSEL_REG			(CONN_MCU_CONFIG_BASE + 0x00000114)
+#define CONSYS_MCU_CFG_ACR_REG				(CONN_MCU_CONFIG_BASE + 0x00000110)
