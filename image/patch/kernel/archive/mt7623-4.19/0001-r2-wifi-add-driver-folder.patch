+#else
+
+	scnPSCNFsm(prAdapter, PSCN_RESET, NULL, NULL, NULL, NULL, TRUE, FALSE, FALSE, FALSE);
+#endif
+
+	prScanInfo->fgNloScanning = FALSE;
+
+	return TRUE;
+}
