+int _btif_irq_ctrl(P_MTK_BTIF_IRQ_STR p_irq, bool en)
+{
+	unsigned int eint_num = p_irq->irq_id;
+
+	if (en)
+		enable_irq(eint_num);
+	else
+		disable_irq_nosync(eint_num);
+
+	return 0;
+}
+
+int _btif_irq_ctrl_sync(P_MTK_BTIF_IRQ_STR p_irq, bool en)
+{
+	unsigned int eint_num = p_irq->irq_id;
+
+	if (en)
+		enable_irq(eint_num);
+	else
+		disable_irq(eint_num);
+
+	return 0;
+}
