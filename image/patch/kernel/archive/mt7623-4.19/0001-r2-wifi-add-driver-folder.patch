+	for (u4QueArrayIdx = 0; u4QueArrayIdx < CFG_NUM_OF_RX_BA_AGREEMENTS; u4QueArrayIdx++) {
+		prQM->arRxBaTable[u4QueArrayIdx].fgIsValid = FALSE;
