+*           ucType : 0 for beacon, 1 for probe req, 2 for probe resp
+*
+* \return
+*           The WSC IE length
+*/
+/*----------------------------------------------------------------------------*/
+UINT_16 kalP2PCalWSC_IELen(IN P_GLUE_INFO_T prGlueInfo, IN UINT_8 ucType)
+{
+	ASSERT(prGlueInfo);
+
+	ASSERT(ucType < 3);
+
+	return prGlueInfo->prP2PInfo->u2WSCIELen[ucType];
+}
