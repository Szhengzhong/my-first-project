+		} else if (prAdapter->aePreferBand[NETWORK_TYPE_AIS_INDEX]
+				== BAND_5G) {
+			ScanReqMsg->eScanChannel = SCAN_CHANNEL_5G;
+		} else {
+			ScanReqMsg->eScanChannel = SCAN_CHANNEL_FULL;
+			ASSERT(0);
+		}
+
+
+}
