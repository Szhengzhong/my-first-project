+{
+	P_AIS_SPECIFIC_BSS_INFO_T prBssSpecInfo;
+
+	prBssSpecInfo = &prAdapter->rWifiVar.rAisSpecificBssInfo;
+	ASSERT(prBssSpecInfo);
