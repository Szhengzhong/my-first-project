+	UINT_32 u4FreeCount;
+	UINT_32 u4AllocNullCount;
+#endif				/* CFG_DBG_MGT_BUF */
+
+	BUF_BITMAP rFreeBlocksBitmap;
+	UINT_8 aucAllocatedBlockNum[MAX_NUM_OF_BUF_BLOCKS];
+} BUF_INFO_T, *P_BUF_INFO_T;
